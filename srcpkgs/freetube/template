# Template file for 'freetube'
pkgname=freetube
version=0.26.0
revision=1
archs="x86_64* aarch64*"
hostmakedepends="nodejs pnpm"
depends="electron35"
short_desc="Open source desktop YouTube player built with privacy in mind"
maintainer="devopnem <devopenm@proton.me>"
license="AGPL-3.0-or-later"
homepage="https://freetubeapp.io"
changelog="https://github.com/FreeTubeApp/FreeTube/releases"
distfiles="https://github.com/FreeTubeApp/FreeTube/archive/v${version}-beta.tar.gz"
checksum=6732e4092bebf351b77a7eb946b05a19f2d0c3856b3473db3118fe5538f06704
nocross="electron"

do_build() {
	export ELECTRON_SKIP_BINARY_DOWNLOAD=1
	export npm_config_manage_package_manager_versions=false
	pnpm install --frozen-lockfile --ignore-scripts
	pnpm run pack
}

do_install() {
	vlicense LICENSE
	vmkdir usr/lib/freetube
	vcopy dist usr/lib/freetube
	vcopy package.json usr/lib/freetube
	vbin "${FILESDIR}/freetube.sh" freetube
	vinstall "${FILESDIR}/freetube.desktop" 644 usr/share/applications
	vinstall _icons/icon.svg 644 usr/share/pixmaps freetube.svg
}
